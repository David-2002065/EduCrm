# backend/.env namunasi. Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# .env GitHub'ga yuklanmaydi, .env.example esa yuklanadi (unda maxfiy narsa bo'lmasin).

# Claude API kaliti: console.anthropic.com -> API Keys (markazning o'z hisobi)
ANTHROPIC_API_KEY=

# AI ustoz modeli: claude-opus-5-5 (eng kuchli) | claude-sonnet-5-5 (~2x arzon) | claude-haiku-4-5 (~4x arzon)
AI_TUTOR_MODEL=claude-opus-5-5

# Rasmiy Azure ovozi (ixtiyoriy). portal.azure.com -> Speech service -> Keys and Endpoint
# Bo'sh qolsa bepul edge-tts ishlatiladi (norasmiy, sinov uchun).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# O'quvchilar uchun Telegram bot (test vazifalar). @BotFather -> /newbot -> tokenni shu yerga yozing.
# Bo'sh qolsa bot ishlamaydi, testlarni admin panelda qo'shish baribir mumkin.
TELEGRAM_BOT_TOKEN=
